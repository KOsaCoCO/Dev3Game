  m_Script: {fileID: 11500000, guid: 465d0b4bdeec2254387087bb22eb17c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.CommandParser
  _componentDescription: Reads the clunky word sentence from left to right and cuts
    it into steps. Every time a verb appears a new step starts. Steps that are missing
    a target, a tool or an amount are marked ambiguous, and that is where the agent
    has to guess.
  VerbsNeedingAmount:
  - pour
  - wait
  - cook
  - heat
  - stir
  - mix
  - blend
  - cut
  VerbsNeedingIngredient:
  - put
  - pour
  - cut
  - peel
  - blend
  - pull
  - mix
  VerbsNeedingTool:
  - cut
  - peel
  - blend
  - stir
  - mix
