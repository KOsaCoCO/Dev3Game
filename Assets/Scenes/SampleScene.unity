  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.RecipeGenerator
  _componentDescription: Generates a random order, such as 'Oreon wants a health
    potion'. The order lists only the ingredients and how the cauldron must be kept,
    hot or cold, and for how long. Tools are left out on purpose so the player can
    use any tool they like.
  RecipeLabel: {fileID: 697675800}
  RecipeScrollView: {fileID: 908927012}
  CustomerNames:
  - Oreon
  - Mira
  - Brannoc
  - Selka
  - Duvi
