  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.UncertaintyRandomizer
  _componentDescription: Two randomisers in one. The first is a 50/50 that decides
    whether an unclear instruction is read well or badly. The second rolls 0 to 100
    to decide how well, or how badly. Every roll is written to the console so the
    outcome can be tracked while testing.
  PositiveChancePercent: 50
  MinimumMagnitude: 0
  MaximumMagnitude: 100
  LogEveryRoll: 1
