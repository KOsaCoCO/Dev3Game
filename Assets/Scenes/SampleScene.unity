  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.GameSequenceManager
  _componentDescription: 'The round manager. It asks RecipeGenerator for an order,
    waits for the agent to finish, then scores the potion on two things only: the
    ingredients that went in and whether the cauldron was kept at the right temperature.
    Matching the stated time is a bonus, and every ingredient that was not asked
    for gives the potion sideeffects and costs a little score.'
  WinMatchThreshold: 0.6
  WinQualityThreshold: 0.5
  IngredientShareOfScore: 0.6
  BonusForCorrectTime: 0.1
  PenaltyPerExtraIngredient: 0.05
  PointsPerWin: 1
  PointsPerLoss: 1
  SideEffectMessage: The potion has gotten some sideeffects ...
  WreckedMessage: Your potion has wrecked the person!
  GenerousMessage: The potion actually gave them more than they asked for!
  BrewingPanel: {fileID: 1002079158}
  NamingPanel: {fileID: 1953135920}
  ResultPanel: {fileID: 403065483}
  MenuPanel: {fileID: 426019721}
  CauldronOutputLabel: {fileID: 310667039}
  PotionNameInput: {fileID: 1147467824}
  ResultTitleLabel: {fileID: 1851808802}
  ResultDetailLabel: {fileID: 456918334}
  ResultVerdictLabel: {fileID: 629895963}
  PlayerNameInput: {fileID: 1667800577}
  BrewedPotions: []
  OnRoundStarted:
    m_PersistentCalls:
      m_Calls: []
  OnBrewingStarted:
    m_PersistentCalls:
      m_Calls: []
  OnPotionReadyToName:
    m_PersistentCalls:
      m_Calls: []
  OnRoundWon:
    m_PersistentCalls:
      m_Calls: []
  OnRoundLost:
    m_PersistentCalls:
      m_Calls: []
